# ====================================================================
# YouTube → NotebookLM Sync — 環境變數範例
# 複製本檔為 .env 並填入實際值（本機開發用）
# GitHub Actions 請改至 Settings → Secrets and variables → Actions 設定
# ====================================================================

# ── Google Cloud Platform ────────────────────────────────────────────
# Service Account JSON（整串貼上，含外層大括號）
# 需要的 IAM 角色：Cloud Datastore User（Firestore）、Google Drive API（若使用歸檔）
GCP_CREDENTIALS='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}'

# ── NotebookLM Cookie ────────────────────────────────────────────────
# 從瀏覽器 DevTools (Application → Cookies → notebooklm.google.com) 複製
# 格式：key1=value1; key2=value2; ...
NOTEBOOKLM_COOKIE='SID=...; HSID=...; SSID=...; APISID=...; SAPISID=...; __Secure-1PSID=...; __Secure-3PSID=...'

# ── Line Notify ──────────────────────────────────────────────────────
# 至 https://notify-bot.line.me/my/ 申請個人存取權杖
LINE_NOTIFY_TOKEN='your_line_notify_token_here'

# ── Google Drive（本機備援，正式由 GCP_CREDENTIALS 覆蓋）─────────────
# 舊版設定，保留供參考；新版統一使用 GCP_CREDENTIALS
# GDRIVE_CREDENTIALS=''
